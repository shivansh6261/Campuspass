generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UserRole {
  STUDENT
  ORGANIZER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

enum OrganizerRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum PaymentOrderStatus {
  RESERVED
  ORDER_CREATED
  PAID
  FAILED
  EXPIRED
  REFUND_REQUIRED
  REFUNDED
}

// ==========================================
// STUDENT / USER
// ==========================================

model Student {
  id         String @id @default(cuid())
  name       String
  email      String @unique
  enrollment String @unique
  phone      String
  department String
  year       String

  passwordHash String

  emailVerifiedAt    DateTime?
  verificationStatus VerificationStatus @default(PENDING)
  collegeVerifiedAt  DateTime?

  role          UserRole      @default(STUDENT)
  accountStatus AccountStatus @default(ACTIVE)

  // Authentication
  sessions Session[]

  // Clubs and organizer permissions
  clubMemberships ClubMembership[]

  organizerRequests OrganizerRequest[] @relation("OrganizerApplicant")
  reviewedRequests  OrganizerRequest[] @relation("OrganizerReviewer")

  // Events created by organizers
  createdEvents Event[] @relation("EventCreator")

  // Student event bookings
  registrations Registration[]

  // paid Tickets
  paymentOrders PaymentOrder[]

  // Tickets verified by this organizer
  verifiedCheckIns Registration[] @relation("CheckInVerifier")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([accountStatus])
}

// ==========================================
// SESSION / AUTHENTICATION
// ==========================================

model Session {
  id        String @id @default(cuid())
  studentId String

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  tokenHash String   @unique
  expiresAt DateTime

  createdAt DateTime @default(now())

  @@index([studentId])
  @@index([expiresAt])
}

// ==========================================
// CLUB
// ==========================================

model Club {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  description String?
  logoUrl     String?

  isActive Boolean @default(true)

  memberships       ClubMembership[]
  organizerRequests OrganizerRequest[]
  events            Event[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// CLUB MEMBERSHIP
// ==========================================

model ClubMembership {
  id        String @id @default(cuid())
  studentId String
  clubId    String

  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  club    Club    @relation(fields: [clubId], references: [id], onDelete: Restrict)

  isActive Boolean @default(true)

  approvedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([studentId, clubId])
  @@index([clubId, isActive])
}

// ==========================================
// ORGANIZER REQUEST
// ==========================================

model OrganizerRequest {
  id        String @id @default(cuid())
  studentId String
  clubId    String

  student Student @relation("OrganizerApplicant", fields: [studentId], references: [id], onDelete: Restrict)
  club    Club    @relation(fields: [clubId], references: [id], onDelete: Restrict)

  status OrganizerRequestStatus @default(PENDING)
  reason String?

  reviewedById String?
  reviewer     Student? @relation("OrganizerReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  reviewNote String?
  reviewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, clubId])
  @@index([status])
  @@index([clubId, status])
}

// ==========================================
// EVENT
// ==========================================

model Event {
  id          String  @id @default(cuid())
  title       String
  description String  @db.Text
  bannerUrl   String?
  venue       String

  // Event schedule
  startAt              DateTime
  endAt                DateTime
  registrationDeadline DateTime

  // Seat capacity
  capacity Int

  // Free / Paid event
  isPaid        Boolean        @default(false)
  pricePaise    Int            @default(0)
  paymentOrders PaymentOrder[]

  // Event status
  status EventStatus @default(DRAFT)

  // Organizing club
  clubId String
  club   Club   @relation(fields: [clubId], references: [id], onDelete: Restrict)

  // Event creator
  createdById String
  createdBy   Student @relation("EventCreator", fields: [createdById], references: [id], onDelete: Restrict)

  // Student registrations
  registrations Registration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clubId])
  @@index([status, startAt])
  @@index([createdById])
}

// ==========================================
// EVENT REGISTRATION / QR TICKET
// ==========================================

model Registration {
  id String @id @default(cuid())

  // Registered student
  studentId    String
  student      Student       @relation(fields: [studentId], references: [id], onDelete: Restrict)
  paymentOrder PaymentOrder?
  // Registered event
  eventId      String
  event        Event         @relation(fields: [eventId], references: [id], onDelete: Restrict)

  // Registration timestamp
  createdAt DateTime @default(now())

  // ========================================
  // QR CHECK-IN / ATTENDANCE
  // ========================================

  // Null means the ticket has not been used.
  checkedInAt DateTime?

  // Organizer who verified the ticket
  checkedInById String?
  checkedInBy   Student? @relation("CheckInVerifier", fields: [checkedInById], references: [id], onDelete: SetNull)

  // Prevent duplicate registrations
  @@unique([studentId, eventId])
  // Booking queries
  @@index([eventId])
  @@index([studentId, createdAt])
  // Attendance queries
  @@index([eventId, checkedInAt])
  @@index([checkedInById])
}

//Razorpay 

model PaymentOrder {
  id String @id @default(cuid())

  studentId String
  eventId   String

  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  event   Event   @relation(fields: [eventId], references: [id], onDelete: Restrict)

  razorpayOrderId   String? @unique
  razorpayPaymentId String? @unique

  amountPaise Int
  currency    String @default("INR")

  status PaymentOrderStatus @default(RESERVED)

  // A seat is reserved only until this timestamp.
  expiresAt DateTime

  // Linked only after successful payment confirmation.
  registrationId String?       @unique
  registration   Registration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId, eventId])
  @@index([eventId, status, expiresAt])
  @@index([status, createdAt])
}
